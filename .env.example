PORT=3000

# AWS S3 (ViviFi summary files backfill)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-real-key-id
AWS_SECRET_ACCESS_KEY=replace-with-real-secret
AWS_BUCKET_NAME=leads-processed-reports
AWS_BUCKET_NAME_DEDUPE_SYSTEM=sml-dedupe-check
DEDUPE_SYS_ENV=production

# ClickHouse connection (analytics store)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-real-password
CLICKHOUSE_DATABASE=webhook_data

# Header name FlexSalary sends the API key in (per their docs, e.g. "apikey")
WEBHOOK_AUTH_HEADER=apikey

# The API key value FlexSalary was given to authenticate as this partner
FLEXSALARY_API_KEY=replace-with-real-key
